# Copy this file to .env for local development. Configure the same names in the
# Preview and Production scopes in Vercel; never commit real values.

# Public browser configuration. These values are identifiers, not secrets.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# If the project uses Supabase's newer publishable key, set this instead of
# VITE_SUPABASE_ANON_KEY:
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Google and GitHub are shown by default and checked against live Supabase
# provider settings. Configure provider credentials and allowed callback URLs.
VITE_AUTH_GOOGLE_ENABLED=true
VITE_AUTH_GITHUB_ENABLED=true
VITE_AUTH_APPLE_ENABLED=false

# Server-only Supabase configuration. Never prefix the service-role key with VITE_.
# SUPABASE_URL must identify the same project as VITE_SUPABASE_URL.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only AI provider secrets. Each feature uses its dedicated Groq key
# when set. Features without a Groq key use NVIDIA_API_KEY, if set; otherwise
# that feature is unavailable. Never prefix any of these values with VITE_.
GROQ_QUIZ_API_KEY=
GROQ_RECALL_API_KEY=
GROQ_INSIGHTS_API_KEY=
GROQ_TIMETABLE_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REQUEST_TIMEOUT_MS=20000
NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-20b
NVIDIA_REQUEST_TIMEOUT_MS=20000

# Local Express development server only. Vercel assigns PORT automatically.
PORT=8787
