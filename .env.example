# Copy this file to .env for local development. Configure the same names in the
# Preview and Production scopes in Vercel; never commit real values.

# Public browser configuration. These values are identifiers, not secrets.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# If the project uses Supabase's newer publishable key, set this instead of
# VITE_SUPABASE_ANON_KEY:
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Public OAuth UI gates. Keep a provider false until its dashboard credentials,
# Supabase provider switch, redirect URLs, and full callback flow are verified.
VITE_AUTH_GOOGLE_ENABLED=true
VITE_AUTH_GITHUB_ENABLED=false
VITE_AUTH_APPLE_ENABLED=false

# Server-only Supabase configuration. Never prefix the service-role key with VITE_.
# SUPABASE_URL must identify the same project as VITE_SUPABASE_URL.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only NVIDIA NIM configuration. Never prefix these with VITE_.
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_MODEL_QUIZ=
NVIDIA_MODEL_TIMETABLE=
NVIDIA_MODEL_INSIGHT=
NVIDIA_MODEL_RECALL=
NVIDIA_MODEL_VERIFIER=
NVIDIA_REQUEST_TIMEOUT_MS=20000

# Local Express development server only. Vercel assigns PORT automatically.
PORT=8787
