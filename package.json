{
  "name": "recall-plus",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": "24.x",
    "npm": ">=11.12.0 <12"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c magenta,cyan \"node --watch server.js\" \"vite --host 0.0.0.0 --port 5173 --strictPort\"",
    "dev:web": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "dev:api": "node --watch server.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "lint": "eslint .",
    "verify:router": "node scripts/verify-router.mjs",
    "validate:vercel-env": "node scripts/validate-vercel-env.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "scan:history": "node scripts/scan-git-history.mjs",
    "curriculum:import": "node scripts/import-cbse-curriculum.ts",
    "curriculum:validate": "node scripts/validate-cbse-curriculum.ts",
    "curriculum:report": "node scripts/generate-curriculum-report.ts",
    "curriculum:sql": "node scripts/generate-curriculum-sql.ts",
    "curriculum:sql:check": "node scripts/check-frozen-curriculum-sql.ts",
    "curriculum:allowlist:sql": "node scripts/generate-allowlist-migration.ts",
    "curriculum:xii:sql": "node scripts/generate-class-12-migration.ts",
    "curriculum:client": "node scripts/generate-client-curriculum-nodes.ts",
    "curriculum:client:check": "node scripts/generate-client-curriculum-nodes.ts --check",
    "curriculum:coverage": "node scripts/generate-curriculum-coverage-doc.ts",
    "test:db:smoke": "node scripts/smoke-test-curriculum-db.mjs",
    "audit:prod": "node scripts/audit-policy.mjs --omit=dev",
    "audit:all": "node scripts/audit-policy.mjs",
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "check": "npm run verify:router && npm run curriculum:validate && npm run curriculum:sql:check && npm run curriculum:client:check && npm run test:db:smoke && npm run typecheck && npm run lint && npm test && npm run build && npm run scan:secrets && npm run scan:history",
    "vercel:build": "npm run validate:vercel-env && npm run check && npm run audit:all"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@supabase/supabase-js": "2.110.8",
    "@vitejs/plugin-react": "^6.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "7.18.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "nanoid": "3.3.18"
  }
}
